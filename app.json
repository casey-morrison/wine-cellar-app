{
  "expo": {
    "name": "Wine Cellar",
    "slug": "wine-cellar-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "winecellar",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.caseymorrison.winecellar",
      "infoPlist": {
        "NSCameraUsageDescription": "Photograph wine bottle labels to identify and catalog them.",
        "NSPhotoLibraryUsageDescription": "Choose wine bottle photos from your library to identify and catalog them."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1A1214",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.caseymorrison.winecellar"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-image",
      "expo-dev-client",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Wine Cellar to access your photos to identify bottles.",
          "cameraPermission": "Allow Wine Cellar to use the camera to photograph bottle labels."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0D0A0B"
        }
      ],
      [
        "expo-mlkit-ocr",
        {
          "iosEngine": "auto"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e102b573-6dbc-473f-ac11-52247fbe5a5e"
      }
    },
    "owner": "casey-morrisons-team"
  }
}
